{% extends 'base.html.twig' %}

{% block title %}Planning Poker{% endblock %}

{% block body %}
    <div class="poker-wrapper">
        <h1>Nouvelle Partie de Planning Poker</h1>

        <form method="POST" action="{{ path('app_partie_creer') }}" enctype="multipart/form-data">
            <div class="form-group">
                <label for="backlog">Importer un backlog :</label>
                <input id="backlog" type="file" name="file" accept=".json" required>
                <label for="nb_joueurs">Nombre de participants :</label>
                <select id="nb_joueurs" class="form-control">
                    <option value="" disabled selected>Choisir...</option>
                    <option value="2">2 joueurs</option>
                    <option value="3">3 joueurs</option>
                    <option value="4">4 joueurs</option>
                    <option value="5">5 joueurs</option>
                    <option value="6">6 joueurs</option>
                </select>
            </div>

            <div id="liste_champs_joueurs" class="form-group">
                <!-- Les champs texte s'insèrent ici dynamiquement -->
            </div>

            <button type="submit" class="btn-submit" id="btn_lancer" style="display: none;">
                Lancer la partie
            </button>
        </form>

        {% if app.session.get('error') %}
            <p> {{app.session.get('error')}} </p>
        {% endif %}
    </div>

    <script>
        // sélection des élements HTML.
        selectNb = document.getElementById('nb_joueurs');
        container = document.getElementById('liste_champs_joueurs');
        btnLancer = document.getElementById('btn_lancer');

        selectNb.addEventListener('change', function () {
            // Initialisation de la zone d'input
            total = parseInt(this.value, 10);
            container.innerHTML = '<label>Noms des joueurs :</label>';

            // création des inputs
            // joueurs[] permet à php de créer automatiquement un tableau
            for (let i = 1; i <= total; i++) {
                input = document.createElement('input');
                input.type = 'text';
                input.name = 'joueurs[]';
                input.placeholder = 'Joueur ' + i;
                input.required = true;
                input.className = 'form-control player-field';
                container.appendChild(input);
            }

            btnLancer.style.display = 'block';
        });
    </script>
{% endblock %}
