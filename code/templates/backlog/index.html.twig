{% extends 'base.html.twig' %}

{% set backlog = app.session.get('backlog') %}

{% block title %}Hello BacklogController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>C:/Users/enzov/Documents/GitHub/projet_planningPoker/code/src/Controller/BacklogController.php</code></li>
        <li>Your template at <code>C:/Users/enzov/Documents/GitHub/projet_planningPoker/code/templates/backlog/index.html.twig</code></li>
    </ul>

    {% if app.session.get('backlog') %}
        <p> Backlog loaded </p>
        <p> {{backlog.fonctionnalites[0].titre}} </p>
    {% endif %}

    <form action="http://127.0.0.1:8000/backlog/load" method="post" enctype="multipart/form-data">
        <input type="file" name="file" accept=".json">
        <input type="submit" name="button" value="INSCRIPTION">
    </form>
</div>
{% endblock %}
